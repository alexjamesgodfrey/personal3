# Public application configuration
CHATDB_URL=https://chatdb.io
AGENTDB_API_URL=https://your-agentdb-host.example
PUBLIC_NEWSLETTER_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# Server-only application secrets
AGENTDB_API_KEY=replace-with-agentdb-api-key
DATABASE_URL=postgresql://user:password@host:5432/database
RESEND_API_KEY=replace-with-resend-api-key
NEWSLETTER_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
NEWSLETTER_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional exact origins, comma-separated. The request origin is always allowed.
NEWSLETTER_ALLOWED_ORIGINS=https://alexgodfrey.com

# Development defaults to optional; production always requires Turnstile.
NEWSLETTER_TURNSTILE_MODE=optional

# CSP defaults to report-only. Set to enforce after reviewing violation reports.
ASTRO_CSP_MODE=report-only

# Optional: keep server-island encryption stable across distributed processes.
# Generate with: pnpm --filter @alexgodfrey/web astro create-key
# ASTRO_KEY=replace-with-generated-astro-key
