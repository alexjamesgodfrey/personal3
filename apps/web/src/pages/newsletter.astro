---
import Layout from '@alexgodfrey/web/layouts/BaseLayout.astro';
import { NewsletterForm } from '../components/newsletter-form';

export const prerender = true;
---

<Layout
  title="Newsletter | Alex Godfrey"
  description="Occasional notes from Alex Godfrey on building software for longevity."
  markdownUrl="/newsletter.md"
>
  <main class="mx-auto flex min-h-screen w-full max-w-2xl items-center px-4 py-16">
    <section class="w-full rounded-xl border-2 border-border bg-background p-6 sm:p-10">
      <p class="font-mono text-sm uppercase text-muted-foreground">Newsletter</p>
      <h1 class="mt-2 text-3xl font-semibold">Join the newsletter</h1>
      <p class="mt-3 text-muted-foreground">
        Occasional notes on what I'm building, reading, and testing. Focused on longevity.
      </p>

      <NewsletterForm client:visible className="mt-8" />

      <nav aria-label="Related pages" class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
        <a href="/" class="underline">Homepage</a>
        <a href="/newsletter.md" type="text/markdown" class="underline">This page in Markdown</a>
      </nav>
    </section>
  </main>
</Layout>
