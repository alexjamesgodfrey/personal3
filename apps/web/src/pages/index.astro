---
import oneTwentyOneInterface from '../assets/images/121health.webp';
import conquerBiomark from '../assets/images/conquer-biomark.png';
import profilePhoto from '../assets/images/profile.webp';
import HomeActionButtons from '../components/home-action-buttons.astro';
import { HomePopups } from '../components/home-popups';
import ProfileImage from '../components/profile-image.astro';
import Altum from '../components/work/altum.astro';
import OneTwentyOne from '../components/work/onetwentyone.astro';
import Layout from '@alexgodfrey/web/layouts/BaseLayout.astro';
import BlogPreviewCard from '../components/blog-preview-card.astro';
import SHV from '../components/work/shv.astro';
import HumidityCard from '../components/grid/airthings/humidity.astro';
import RadonCard from '../components/grid/airthings/radon.astro';
import BenjiQuote from '../components/grid/benji-quote.astro';
import CellPaintVideo from '../components/grid/cellpaint-video.astro';
import HumanOrMachine from '../components/human-or-machine.astro';
import Icon from '../components/icon-sprite';
import { Logo, Logos } from '../components/utilities/logo';
import { absoluteUrl, profilePageStructuredData, siteContent } from '../lib/site-content';
import { Picture } from 'astro:assets';

export const prerender = true;

const structuredData = profilePageStructuredData(absoluteUrl(profilePhoto.src));
---

<Layout
  title={`${siteContent.name} — ${siteContent.role}`}
  description={siteContent.description}
  markdownUrl="/about.md"
  structuredData={structuredData}
>
  <div class="relative w-full bg-background flex flex-col">
    <div class="mt-8 sm:mt-12 lg:mt-24 mx-3 sm:mx-12 lg:mx-24 flex flex-col space-y-8">
      <!-- Header that transitions on scroll - STICKY -->
      <div
        id="header-container"
        class="hero-header sticky top-0 bg-background z-10 flex flex-col pt-4 pb-4"
      >
        <!-- Role label above the name - collapses away when scrolled -->
        <div class="hero-row hero-row-open">
          <div class="min-h-0 overflow-hidden">
            <div class="pb-10">
              <div
                id="fullstack-label"
                class="font-mono border-l border-muted-foreground/30 text-muted-foreground/80 text-sm flex px-4 sm:px-8 items-center gap-2"
              >
                <Icon name="squareStackUp" className="size-4 text-muted-foreground/80" />
                <p class="hidden sm:block">{siteContent.role}</p>
                <p class="block sm:hidden">{siteContent.shortRole}</p>
              </div>
            </div>
          </div>
        </div>

        <div
          id="header-content"
          class="flex relative items-start gap-4 justify-between px-4 sm:px-8 border-l border-r border-muted-foreground/30"
        >
          <div class="flex flex-col">
            <div class="flex items-center gap-2 sm:gap-4">
              <h1 class="font-semibold text-xl md:text-3xl text-muted-foreground">
                {siteContent.name}
              </h1>
              <ProfileImage />
            </div>

            <!-- Role label below the name - revealed when scrolled -->
            <div class="hero-row hero-row-closed">
              <div class="min-h-0 overflow-hidden">
                <div
                  id="compact-label"
                  class="font-mono text-muted-foreground/80 text-sm flex pt-1 items-center gap-2"
                >
                  <Icon name="squareStackUp" className="size-4 text-muted-foreground/80" />
                  <p class="hidden sm:block">{siteContent.role}</p>
                  <p class="block sm:hidden">{siteContent.shortRole}</p>
                </div>
              </div>
            </div>

            <!-- Description paragraphs - collapse away when scrolled -->
            <div class="hero-row hero-row-open">
              <div class="min-h-0 overflow-hidden">
                <div id="description-text" class="flex flex-col gap-1 py-2">
                  <p class="font-medium text-muted-foreground/80 text-sm sm:text-base">
                    {siteContent.identity}
                  </p>
                  <p
                    class="hidden sm:block font-medium text-muted-foreground/80 text-sm sm:text-base"
                  >
                    {siteContent.education}
                  </p>
                  <p class="sm:hidden font-medium text-muted-foreground/80 text-sm sm:text-base">
                    {siteContent.educationShort}
                  </p>
                  <p class="font-medium text-muted-foreground/80 text-sm sm:text-base">
                    {siteContent.focus}
                  </p>
                </div>
              </div>
            </div>

            <!-- Buttons - below description, collapse away when scrolled -->
            <div class="hero-row hero-row-open">
              <div class="min-h-0 overflow-hidden">
                <div id="action-buttons" class="flex pt-1 gap-4 items-center">
                  <HomeActionButtons />
                </div>
              </div>
            </div>

            <!-- Skills sidebar - fades out when scrolled -->
            <div
              id="skills-sidebar"
              class="absolute right-2 top-0 bottom-0 flex flex-col-reverse items-center justify-around"
            >
              <Logo name={Logos.PostgreSQL} className="size-4" />
              <Logo name={Logos.AWS} className="size-4" />
              <Logo name={Logos.Astro} className="size-4" />
              <Logo name={Logos.Next} className="size-4" />
              <Logo name={Logos.Tailwind} className="size-4" />
              <Logo name={Logos.React} className="size-4" />
              <Logo name={Logos.TypeScript} className="size-4" />
            </div>
            <p
              id="skills-label"
              class="hidden uppercase sm:block absolute -right-9.5 top-1/2 mb-4 -translate-y-1/2 rotate-90 font-mono text-muted-foreground/80 text-sm"
            >
              Skills
            </p>
          </div>

          <!-- Buttons container for scrolled state -->
          <div
            id="action-buttons-right"
            class="flex flex-col gap-2 items-end absolute right-4 top-0 lg:static lg:right-auto lg:top-auto"
          >
            <HomeActionButtons />
          </div>
        </div>
      </div>

      <div class="px-4 sm:px-8 sm:mt-12 border-l border-r border-muted-foreground/30 grid-rows-3">
        <div class="grid grid-cols-1 lg:grid-cols-3 border">
          <div class="flex flex-col col-span-2 lg:border-r border-b lg:border-b-0">
            <div class="border-b">
              <a
                href="#onetwentyone-section"
                class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
                aria-label="Jump to OneTwentyOne section"
              >
                <HumidityCard />
              </a>
            </div>
            <!-- <Co2Card /> -->
            <a
              href="#onetwentyone-section"
              class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
              aria-label="Jump to OneTwentyOne section"
            >
              <RadonCard />
            </a>
          </div>
          <div class="h-40 flex w-full">
            <div class="w-full"><BlogPreviewCard slug="red-bull" /></div>
            <!-- <BlogPreviewCard slug="sync-engine" /> -->
          </div>
        </div>
        <div class="grid grid-col-1 lg:grid-cols-5 border-b border-r border-l">
          <div class="lg:border-r col-span-2 grid grid-rows-2">
            <a
              href="/resources/Letter%20of%20rec%20for%20Alex.pdf"
              target="_blank"
              rel="noreferrer"
              class="block border-b lg:border-b-0 h-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
              aria-label="Read letter of recommendation"
            >
              <BenjiQuote />
            </a>
            <a
              href="https://thiscellpaintingdoesnotexist.com"
              target="_blank"
              rel="noreferrer"
              class="border-b lg:border-b-0 flex flex-col items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
              aria-label="Visit This Cell Painting Does Not Exist"
            >
              <CellPaintVideo />
            </a>
          </div>
          <div class="col-span-2">
            <div class="">
              <a
                href="#onetwentyone-section"
                class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
                aria-label="Jump to OneTwentyOne section"
              >
                <Picture
                  src={conquerBiomark}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[480, 768, 1200, 1600]}
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  alt="Conquer biomarker analysis interface"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full"
                />
              </a>
            </div>
            <div
              class="h-64 border-t relative flex flex-col items-center justify-center overflow-hidden bg-muted/20"
            >
              <div class="max-w-sm px-6 text-center">
                <p class="font-mono text-xs uppercase tracking-[0.25em] text-muted-foreground">
                  ChatDB
                </p>
                <p class="mt-3 text-lg font-medium">Explore an interactive data visualization</p>
                <p class="mt-2 text-sm text-muted-foreground">
                  Open the full chart on ChatDB without loading a third-party embed on this page.
                </p>
              </div>
              <a
                href="https://www.chatdb.io/apps/a2c51623-badd-4ef2-a830-e7c39a1df343"
                target="_blank"
                rel="noreferrer"
                class="absolute inset-0 z-10"
                aria-label="Open the interactive ChatDB visualization"></a>
            </div>
          </div>
          <div class="hidden lg:block border-l">
            <a
              href="#onetwentyone-section"
              class="block h-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
              aria-label="Jump to OneTwentyOne section"
            >
              <Picture
                src={oneTwentyOneInterface}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[284, 426, 568]}
                sizes="(min-width: 1024px) 20vw, 100vw"
                alt="121 Health interface"
                loading="lazy"
                decoding="async"
                class="object-cover h-full w-full"
              />
            </a>
          </div>
        </div>
      </div>

      <div class="grid grid-rows-[auto_1fr] mt-8 lg:mt-24">
        <div class="relative">
          <SHV />
          <OneTwentyOne />
          <Altum />
        </div>
      </div>
    </div>
    <div class="pb-16 lg:pb-0 dither-lg md:dither-2xl">
      <p
        aria-hidden="true"
        class="font-mono font-bold text-[5rem] md:text-[16rem] text-muted-foreground uppercase text-center"
      >
        Godfrey
      </p>
    </div>
    <footer class="border-t border-muted-foreground/20 px-6 pt-8 pb-24">
      <nav
        aria-label="Primary"
        class="mx-auto flex max-w-3xl flex-wrap justify-center gap-x-6 gap-y-3 font-mono text-sm"
      >
        <a href="/" aria-current="page" class="underline underline-offset-4">Profile</a>
        <a href="/blog/red-bull" class="underline underline-offset-4">Writing</a>
        <a href="/newsletter" class="underline underline-offset-4">Newsletter</a>
        <a href="/contact" class="underline underline-offset-4">Contact</a>
        <a
          href={siteContent.resources.weddingGallery}
          class="underline underline-offset-4"
        >
          Wedding gallery
        </a>
      </nav>
    </footer>
    <!-- <MasonryGrid cells={cells} className="p-2" columns={4} gap={8} /> -->
    <!-- <ProfileCard /> -->
  </div>
  <div class="fixed bottom-4 left-[calc(50%-6rem)] z-[99999999]">
    <HumanOrMachine defaultValue="human" machineLink="/about.md" humanLink="/" />
  </div>
  <HomePopups profileImageSrc={profilePhoto.src} client:idle />

  <style is:global>
    /* The header animates between exactly two states (expanded/collapsed) via
       the `is-collapsed` class. Rows that appear or disappear animate their
       height with grid-template-rows (1fr <-> 0fr) so nothing is ever measured
       in pixels and every breakpoint stays correct. */
    html {
      /* Header collapse changes document height; scroll anchoring would fight
         it and oscillate. */
      overflow-anchor: none;
    }

    .hero-header {
      transition: padding 0.3s ease;
    }
    .hero-header.is-collapsed {
      padding-top: 2rem;
      padding-bottom: 0.25rem;
    }

    .hero-row {
      display: grid;
      transition:
        grid-template-rows 0.3s ease,
        opacity 0.3s ease,
        visibility 0.3s;
    }
    .hero-row-open {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .hero-row-closed {
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
    }
    .is-collapsed .hero-row-open {
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
    }
    .is-collapsed .hero-row-closed {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }

    /* The compact label slides down into place as its row opens */
    #compact-label {
      transform: translateY(-6px);
      transition: transform 0.3s ease;
    }
    .is-collapsed #compact-label {
      transform: translateY(0);
    }

    #skills-sidebar,
    #skills-label {
      transition:
        opacity 0.3s ease,
        visibility 0.3s;
    }
    .is-collapsed #skills-sidebar,
    .is-collapsed #skills-label {
      opacity: 0;
      visibility: hidden;
    }

    #action-buttons-right {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-4px);
      transition:
        opacity 0.3s ease,
        visibility 0.3s,
        transform 0.3s ease;
    }
    .is-collapsed #action-buttons-right {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    /* Applied while snapping to an initial state or taking measurements */
    .hero-no-anim,
    .hero-no-anim * {
      transition: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-header,
      .hero-row,
      #compact-label,
      #skills-sidebar,
      #skills-label,
      #action-buttons-right {
        transition: none;
      }
    }
  </style>

  <script>
    type PopupKind = 'contact' | 'profile';
    type PopupRequest = {
      popup: PopupKind;
      mode: 'open' | 'toggle';
    };
    type HomeActionWindow = Window & {
      __homeActionHandlersAttached?: boolean;
      __homePopupRequest?: PopupRequest;
    };

    // Collapse/expand thresholds are separated (hysteresis) so the header
    // never flip-flops when the scroll position hovers around a boundary.
    const COLLAPSE_AT = 64;
    const EXPAND_AT = 12;

    const homeWindow = window as HomeActionWindow;
    const headerContainer = document.getElementById('header-container');
    let collapsed = false;

    const isTextEntryTarget = (target: EventTarget | null) =>
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      (target instanceof HTMLElement && target.isContentEditable);

    const updateWorkTriggers = () => {
      document.querySelectorAll<HTMLElement>('[data-work-trigger]').forEach((trigger) => {
        const label = trigger.querySelector<HTMLElement>('[data-work-label]');
        const shortcut = trigger.querySelector<HTMLElement>('[data-work-shortcut]');

        trigger.setAttribute('href', collapsed ? '/resources/resume.pdf' : '#shv-section');
        if (label) {
          label.textContent = collapsed ? 'Resume' : 'View Work';
        }
        if (shortcut) {
          shortcut.textContent = collapsed ? 'R' : 'W';
        }
      });
    };

    const setCollapsed = (next: boolean) => {
      if (collapsed === next) {
        return;
      }
      collapsed = next;
      headerContainer?.classList.toggle('is-collapsed', next);
      updateWorkTriggers();
    };

    const onScroll = () => {
      const y = window.scrollY;
      if (y > COLLAPSE_AT) {
        setCollapsed(true);
      } else if (y < EXPAND_AT) {
        setCollapsed(false);
      }
    };

    const smoothScrollTo = (target: HTMLElement) => {
      // The header collapses on the way down, shifting everything below it.
      // Measure the target in the collapsed layout (without painting it) so
      // the smooth scroll lands exactly right: centered when the section fits,
      // otherwise tucked just below the sticky header.
      const measureCollapsed = !collapsed && headerContainer;
      if (measureCollapsed) {
        headerContainer.classList.add('hero-no-anim', 'is-collapsed');
      }
      const rect = target.getBoundingClientRect();
      const elementTop = window.scrollY + rect.top;
      const headerHeight = headerContainer?.offsetHeight ?? 0;
      const offset = Math.max((window.innerHeight - rect.height) / 2, headerHeight + 16);
      if (measureCollapsed) {
        headerContainer.classList.remove('is-collapsed');
        void headerContainer.offsetHeight;
        headerContainer.classList.remove('hero-no-anim');
      }

      window.scrollTo({ top: Math.max(elementTop - offset, 0), behavior: 'smooth' });
    };

    const scrollToWork = () => {
      const shvElement = document.getElementById('shv-section');
      if (shvElement) {
        smoothScrollTo(shvElement);
      }
    };

    const requestPopup = (popup: PopupKind, mode: PopupRequest['mode']) => {
      const request = { popup, mode };
      homeWindow.__homePopupRequest = request;
      window.dispatchEvent(
        new CustomEvent<PopupRequest>('home:popup-request', { detail: request }),
      );
    };

    const handleHomeActionClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      // Let modified clicks (open in new tab, etc.) behave natively
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return;
      }

      if (event.target.closest('[data-profile-trigger]')) {
        requestPopup('profile', 'open');
        return;
      }

      if (event.target.closest('[data-contact-trigger]')) {
        event.preventDefault();
        requestPopup('contact', 'open');
        return;
      }

      if (event.target.closest('[data-work-trigger]')) {
        event.preventDefault();
        if (collapsed) {
          window.location.assign('/resources/resume.pdf');
        } else {
          scrollToWork();
        }
        return;
      }

      // Smoothly scroll same-page anchor links (e.g. the grid cards) instead
      // of letting the browser jump instantly.
      const anchor = event.target.closest<HTMLAnchorElement>('a[href^="#"]');
      if (anchor) {
        const target = document.getElementById(decodeURIComponent(anchor.hash.slice(1)));
        if (target) {
          event.preventDefault();
          smoothScrollTo(target);
        }
      }
    };

    const handleHomeActionKeydown = (event: KeyboardEvent) => {
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.altKey ||
        event.shiftKey ||
        isTextEntryTarget(event.target)
      ) {
        return;
      }

      const key = event.key.toLowerCase();

      if (key === 'c') {
        event.preventDefault();
        requestPopup('contact', 'toggle');
      } else if (key === 'w' && !collapsed) {
        event.preventDefault();
        scrollToWork();
      } else if (key === 'r' && collapsed) {
        event.preventDefault();
        window.location.assign('/resources/resume.pdf');
      }
    };

    if (!homeWindow.__homeActionHandlersAttached) {
      document.addEventListener('click', handleHomeActionClick);
      window.addEventListener('keydown', handleHomeActionKeydown);
      homeWindow.__homeActionHandlersAttached = true;
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Snap to the correct initial state without animating (e.g. when the page
    // loads already scrolled), then re-enable transitions.
    headerContainer?.classList.add('hero-no-anim');
    onScroll();
    updateWorkTriggers();
    requestAnimationFrame(() => {
      requestAnimationFrame(() => headerContainer?.classList.remove('hero-no-anim'));
    });
  </script>
</Layout>
