---
import biomarkOverview from '../../assets/images/biomark-overview.webp';
import { siteContent } from '../../lib/site-content';
import { Picture } from 'astro:assets';
import Icon from '../icon-sprite';
import { Logo, Logos } from '../utilities/logo';

const work = siteContent.work.oneTwentyOne;
---

<section
  id="onetwentyone-section"
  class="flex flex-col md:grid md:grid-cols-[40%_1fr] py-10 border-b max-h-screen"
>
  <div class="md:sticky md:top-48 md:self-start">
    <div class="px-8 border-l border-muted-foreground/30 flex flex-col">
      <div class="flex items-center gap-2">
        <h2 class="font-mono font-bold md:text-3xl text-muted-foreground">
          {work.organization}
        </h2>
        <Logo name={Logos.OneTwentyOne} className="size-4.5" />
      </div>
      <div
        class="flex items-center gap-2 text-sm text-muted-foreground/80 uppercase font-mono mt-1"
      >
        <Icon name="pinCircle" className="size-3.5" />
        <p class="font-medium text-muted-foreground/80">{work.location}, {work.dateLabel}</p>
      </div>
      <p class="font-medium text-muted-foreground/80 mt-2">{work.role}</p>
    </div>
    <div class="px-8 mt-4 text-muted-foreground/80 flex flex-col gap-2">
      <p>
        {work.summary}
      </p>
      <p>
        {work.detail} <a href={work.projects[0].url} class="underline">{work.projects[0].name}</a>.
      </p>
    </div>
  </div>
  <div class="hidden md:block h-auto">
    <div>
      <Picture
        src={biomarkOverview}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1344, 1920]}
        sizes="(min-width: 768px) 60vw, 100vw"
        alt="OneTwentyOne biomarker overview"
        loading="lazy"
        decoding="async"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>
