---
import chatdbScreenshot from '../../assets/images/chatdb.webp';
import { siteContent } from '../../lib/site-content';
import { Picture } from 'astro:assets';
import Icon from '../icon-sprite';
import { Logo, Logos } from '../utilities/logo';

const work = siteContent.work.shv;
---

<section
  id="shv-section"
  class="flex flex-col md:grid md:grid-cols-[40%_1fr] py-10 border-y-2 max-h-screen"
>
  <div class="md:sticky md:top-48 md:self-start">
    <div class="px-8 border-l border-muted-foreground/30 flex flex-col">
      <div class="flex items-center gap-2">
        <h2 class="font-mono font-bold md:text-3xl text-muted-foreground">{work.displayName}</h2>
        <Logo name={Logos.SHV} className="h-4 w-auto" />
      </div>
      <div
        class="flex items-center gap-2 text-sm text-muted-foreground/80 uppercase font-mono mt-1"
      >
        <Icon name="pinCircle" className="size-3.5" />
        <p class="font-medium text-muted-foreground/80">{work.location}, {work.dateLabel}</p>
      </div>
      <p class="font-medium text-muted-foreground/80 mt-2">{work.role}</p>
    </div>
    <div class="px-8 mt-4 text-muted-foreground/80 flex flex-col gap-2">
      <p>
        {work.summary}
      </p>
      <p>
        {work.focus} See <a
          href="https://www.modelcontextprotocol.org"
          class="underline">Model Context Protocol</a
        >. Selected projects include:
      </p>
      <ul class="list-disc list-inside pl-4">
        {
          work.projects.map((project) => (
            <li>
              <a href={project.url} class="underline">{project.name}</a>
              <Icon name="arrowUpRight" className="inline mb-1 size-4" />
            </li>
          ))
        }
      </ul>
      <p>
        Additionally, I've had the privilege of building with the following portfolio companies:
      </p>
      <ul class="list-disc list-inside pl-4">
        {
          work.collaborations.map((company) => (
            <li>
              <a href={company.url} class="underline">{company.name}</a>
              <Icon name="arrowUpRight" className="inline mb-1 size-4" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="hidden md:block h-auto">
    <Picture
      src={chatdbScreenshot}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 960, 1400, 1900]}
      sizes="(min-width: 768px) 60vw, 100vw"
      alt="ChatDB interface built at Sutter Hill Ventures"
      loading="lazy"
      decoding="async"
      class="h-auto w-full"
    />
  </div>
</section>
