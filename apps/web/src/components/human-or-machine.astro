---
interface Props {
  defaultValue: 'human' | 'machine';
  machineLink: string;
  humanLink: string;
}

const { defaultValue, machineLink, humanLink } = Astro.props;
const options = [
  { label: 'Human', value: 'human', href: humanLink },
  { label: 'Machine', value: 'machine', href: machineLink },
] as const;
---

<nav
  aria-label="Page version"
  class="flex w-48 items-center gap-3 rounded-xl border-2 border-border bg-background/95 p-4 shadow-2xl backdrop-blur-sm"
>
  {
    options.map((option) => {
      const selected = defaultValue === option.value;

      return (
        <a
          href={option.href}
          type={option.value === 'machine' ? 'text/markdown' : undefined}
          title={option.value === 'machine' ? 'Open the machine-readable Markdown profile' : undefined}
          aria-current={selected ? 'page' : undefined}
          class="flex items-center gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        >
          <span
            aria-hidden="true"
            class="relative flex size-4 shrink-0 items-center justify-center rounded-full border border-primary"
          >
            {selected && <span class="size-2 rounded-full bg-primary" />}
          </span>
          <span class="text-sm font-medium">{option.label}</span>
        </a>
      );
    })
  }
</nav>
